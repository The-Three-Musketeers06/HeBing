<UserControl x:Class="AiVisionStudio.Views.ScriptToolEditor" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AiVisionStudio.Views">
 <UserControl.Resources><Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource ToolGridHeader}"/></UserControl.Resources>
 <Grid Background="{StaticResource Bg}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="60*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="40*"/></Grid.ColumnDefinitions>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="60*"/><RowDefinition Height="5"/><RowDefinition Height="40*"/></Grid.RowDefinitions>
   <Border Background="#1D1F21" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ScrollViewer x:Name="LineScroller" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" IsHitTestVisible="False" Background="#252729">
      <TextBlock x:Name="LineNumbers" Text="1" Foreground="#777D86" FontFamily="Consolas" FontSize="15" LineHeight="17.578125" LineStackingStrategy="BlockLineHeight" Padding="3,10,9,10" TextAlignment="Right"/>
     </ScrollViewer>
     <local:LuaCodeEditor x:Name="CodeEditor" Grid.Column="1" Text="{Binding ScriptParameter.Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}"
       IsReadOnly="{Binding IsRunning}" IsEnabled="{Binding CanEdit}" AcceptsReturn="True" AcceptsTab="True" SpellCheck.IsEnabled="False" FontFamily="Consolas" FontSize="15"
       Background="#1D1F21" Foreground="#C5C8C6" CaretBrush="White" SelectionBrush="#3B536B" BorderThickness="0" Padding="12,10"
       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextChanged="OnCodeChanged" ScrollViewer.ScrollChanged="OnCodeScroll" />
    </Grid>
   </Border>
   <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent"/>
   <Border Grid.Row="2" Background="{StaticResource InputBg}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="输出" Height="32" Padding="10,5" Background="{StaticResource PanelHead}"/>
     <TextBox Text="{Binding ScriptOutputText,Mode=OneWay}" IsReadOnly="True" Background="Transparent" Foreground="#BFC3C9" BorderThickness="0" Padding="12" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    </DockPanel>
   </Border>
  </Grid>
  <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent"/>
  <Grid Grid.Column="2">
   <Grid.RowDefinitions><RowDefinition Height="60*"/><RowDefinition Height="5"/><RowDefinition Height="40*"/></Grid.RowDefinitions>
   <TabControl x:Name="ReferenceTabs" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Border}" BorderThickness="1">
    <TabControl.Resources>
     <Style TargetType="TabItem"><Setter Property="Foreground" Value="#C0C0C5"/><Setter Property="Padding" Value="12,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Head" Background="{StaticResource PanelHead}" Padding="{TemplateBinding Padding}" BorderThickness="0,0,0,2"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Head" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="{StaticResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </TabControl.Resources>
    <TabItem Header="输入变量">
     <DockPanel>
      <Button DockPanel.Dock="Top" Content="+ 添加输入变量" Command="{Binding AddScriptInputCommand}" HorizontalAlignment="Right" Margin="8" Padding="8,4" Foreground="{StaticResource Accent}" Background="{StaticResource AccentSoft}" BorderThickness="0"/>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <ItemsControl ItemsSource="{Binding ScriptInputs}">
        <ItemsControl.ItemTemplate>
         <DataTemplate>
          <Grid Margin="7,2">
           <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
           <Grid.ColumnDefinitions><ColumnDefinition Width="32*"/><ColumnDefinition Width="56*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
           <TextBox Text="{Binding Value,Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ToolTextBox}" Margin="2" IsEnabled="{Binding IsEnabled}" ToolTip="变量名称"/>
           <Button Grid.Column="1" Content="{Binding BindingLabel}" Click="OnInputBinding" HorizontalContentAlignment="Left" Foreground="{StaticResource Accent}" Background="{StaticResource AccentSoft}" BorderThickness="0" Margin="5,2" Padding="8,4"/>
           <Button Grid.Column="2" Content="−" Command="{Binding RemoveItemCommand}" Style="{StaticResource ToolIconButton}" ToolTip="删除输入变量" VerticalAlignment="Center"/>
           <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Text="{Binding Error}" Foreground="{StaticResource Fail}" TextWrapping="Wrap" Visibility="{Binding HasError,Converter={StaticResource ToolBooleanVisibility}}"/>
          </Grid>
         </DataTemplate>
        </ItemsControl.ItemTemplate>
       </ItemsControl>
      </ScrollViewer>
     </DockPanel>
    </TabItem>
    <TabItem Header="函数列表">
     <ListBox x:Name="FunctionList" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" BorderThickness="0" MouseDoubleClick="OnInsertFunction"/>
    </TabItem>
    <TabItem Header="脚本示例">
     <ListBox x:Name="ExampleList" Background="{StaticResource Panel}" Foreground="{StaticResource Text}" BorderThickness="0" MouseDoubleClick="OnInsertExample"/>
    </TabItem>
   </TabControl>
   <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent"/>
   <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4">
    <DockPanel>
     <TextBlock DockPanel.Dock="Top" Text="输出参数" Height="35" Padding="10,7" Background="{StaticResource PanelHead}"/>
                    <ListView ItemsSource="{Binding SelectedOutputs}" Background="Transparent" Foreground="{DynamicResource Text}" BorderThickness="0" ItemContainerStyle="{StaticResource ToolOutputListViewItem}">
                        <ListView.View><GridView>
       <GridViewColumn Header="名称" DisplayMemberBinding="{Binding Name}" Width="160"/>
       <GridViewColumn Header="类型" DisplayMemberBinding="{Binding Type}" Width="100"/>
       <GridViewColumn Header="值" DisplayMemberBinding="{Binding Value}" Width="190"/>
      </GridView></ListView.View>
     </ListView>
    </DockPanel>
   </Border>
  </Grid>
 </Grid>
</UserControl>
