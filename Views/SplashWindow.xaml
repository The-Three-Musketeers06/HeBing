<Window x:Class="AiVisionStudio.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AiVisionStudio.Views"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen"
        Title="ES-Vision-Studio" Icon="/AiVisionStudio;component/Assets/Brand/ESVision.ico"
        Width="790" Height="450" Background="{StaticResource TechSurface}" FontFamily="Microsoft YaHei UI">

    <Border Background="{StaticResource TechSurface}" BorderBrush="#BADCE9" BorderThickness="1"><Grid x:Name="Root">
      <local:TechBackdrop/>
      <TextBlock Text="ES / VISION SYSTEM" FontFamily="Consolas" Foreground="#5694AB" FontSize="10" Margin="40,30,0,0"/>
      <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,25,32,0" Padding="10,4" Background="#DFF2F6" CornerRadius="4"><TextBlock Text="STUDIO V1" FontFamily="Consolas" FontSize="10" Foreground="#167B91"/></Border>
      <Grid Margin="52,78,48,125"><Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Image Source="/AiVisionStudio;component/Assets/Brand/EnshiLogo.png" Width="165" Height="165"/>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="22,0,0,0">
          <TextBlock Text="ES-Vision-Studio" FontFamily="Segoe UI" FontSize="38" FontWeight="SemiBold" Foreground="#063453"/>
          <Rectangle Height="3" Width="70" HorizontalAlignment="Left" Fill="#00A8B8" Margin="2,15,0,14"/>
          <TextBlock Text="机器视觉 · 检测 · 测量 · 自动化" FontSize="16" Foreground="#4D7289"/>
          <TextBlock Text="恩视智能  /  ENSHI INTELLIGENT TECHNOLOGY" FontSize="10" Foreground="#6F92A6" Margin="0,16,0,0"/>
        </StackPanel>
      </Grid>
      <StackPanel VerticalAlignment="Bottom" Margin="52,0,52,64">
        <TextBlock x:Name="StepText" Text="[0/3] 准备工作区" Foreground="#4D7388" FontSize="11"/>
        <Grid x:Name="BarHost" Height="5" Margin="0,9,0,0"><Border Background="#D7E8F1" CornerRadius="2.5"/><Border x:Name="Bar" CornerRadius="2.5" HorizontalAlignment="Left" Width="0"><Border.Background><LinearGradientBrush><GradientStop Color="#0875A9" Offset="0"/><GradientStop Color="#00C2BB" Offset="1"/></LinearGradientBrush></Border.Background></Border></Grid>
      </StackPanel>
      <TextBlock Text="ENSHI  /  INTELLIGENT VISION" FontFamily="Consolas" Foreground="#7C9CAB" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,27"/>
    </Grid></Border>
</Window>
