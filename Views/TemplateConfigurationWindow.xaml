<Window x:Class="AiVisionStudio.Views.TemplateConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AiVisionStudio.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="模板配置" Width="1180" Height="760" MinWidth="900" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="#FFFFFF" Foreground="#374151" FontFamily="Microsoft YaHei UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AiVisionStudio;component/Themes/Light.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="Button">
                <Setter Property="Background" Value="#F3F4F6" />
                <Setter Property="Foreground" Value="#4B5563" />
                <Setter Property="BorderBrush" Value="#D1D5DB" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="MinHeight" Value="32" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E5EBF1" /></Trigger>
                                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#D8E2EB" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="#4B5563" /><Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="#D1D5DB" /><Setter Property="Padding" Value="9,5" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style x:Key="Switch" TargetType="CheckBox">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal">
                                <ContentPresenter VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Border x:Name="Track" Background="#D1D5DB" CornerRadius="3" Width="54" Height="28" BorderBrush="#B8BEC5" BorderThickness="1">
                                    <Border x:Name="Thumb" Width="24" Margin="1" Background="White" CornerRadius="2" HorizontalAlignment="Left" />
                                </Border>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#ED8B32" /><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" /></Trigger>
                                <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5" GlassFrameThickness="0" /></shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#CBD1D8" BorderThickness="1" Background="White">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="72" /><RowDefinition Height="*" /><RowDefinition Height="52" /></Grid.RowDefinitions>
            <Border Background="#FAFAFA" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" MouseLeftButtonDown="OnDrag">
                <Grid>
                    <TextBlock Text="模板配置" FontSize="17" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="□" Width="44" Padding="0" Background="Transparent" BorderThickness="0" FontSize="23" ToolTip="最大化 / 还原" Click="OnMaximize" />
                        <Button Content="×" Width="44" Padding="0" Background="Transparent" BorderThickness="0" FontSize="25" ToolTip="关闭，保留已保存的模板" Click="OnClose" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid x:Name="SourceActions" Grid.Row="1" Background="#F6F7F8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <Button Content="选择当前图像" Click="OnCurrentImage" Margin="0,0,10,0" />
                    <Button Content="选择其他图像" Click="OnOtherImage" Margin="0,0,10,0" />
                    <CheckBox x:Name="StoreImage" Content="模板存图" IsChecked="True" Style="{StaticResource Switch}" ToolTip="将完整训练图像内嵌到工程中，不生成额外文件" Margin="0,0,34,0" Checked="OnSettingChanged" Unchecked="OnSettingChanged" />
                    <Button Content="涂抹屏蔽" Click="OnMaskPaint" Margin="0,0,8,0" /><Button Content="橡皮擦" Click="OnMaskErase" Margin="0,0,8,0" /><Button Content="清除掩膜" Click="OnMaskClear" Margin="0,0,8,0" />
                    <CheckBox x:Name="ShieldAll" Content="全部屏蔽" Style="{StaticResource Switch}" ToolTip="屏蔽全部区域后，可用橡皮擦恢复需要的特征" Checked="OnShieldAll" Unchecked="OnShieldAll" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2" Margin="14,0,10,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                <Border BorderBrush="#E1E4E8" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="#FCFCFD" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                            <DockPanel LastChildFill="True" Margin="8,0">
                                <StackPanel x:Name="ZoomTools" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" />
                                <StackPanel x:Name="EditTools" Orientation="Horizontal" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <local:ImageView x:Name="CanvasView" Grid.Row="1" />
                    </Grid>
                </Border>
                <Grid Grid.Column="1" Margin="20,0,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="*" MinHeight="160" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="列表" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ListBox x:Name="TemplateResults" Grid.Row="1" BorderThickness="0" Background="White" Foreground="#4B5563" HorizontalContentAlignment="Stretch" SelectionChanged="OnResultSelected" />
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="#E0E3E7" BorderThickness="0,1,0,0" Padding="0,14,0,0">
                        <StackPanel x:Name="SettingsPanel">
                            <TextBlock Text="配置参数" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,15" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="52" /><RowDefinition Height="60" /><RowDefinition Height="52" /><RowDefinition Height="60" /></Grid.RowDefinitions>
                                <TextBlock Text="金字塔模式" VerticalAlignment="Center" />
                                <ComboBox x:Name="ScaleMode" Grid.Column="1" VerticalAlignment="Center" SelectedIndex="0" Height="32" SelectionChanged="OnModeChanged"><ComboBoxItem Content="自动" /><ComboBoxItem Content="手动" /></ComboBox>
                                <TextBlock Grid.Row="1" Text="金字塔层数" VerticalAlignment="Center" />
                                <TextBox x:Name="FeatureScale" Grid.Row="1" Grid.Column="1" Text="3.0" VerticalAlignment="Center" ToolTip="手动模式下的特征金字塔层数，1～10" LostKeyboardFocus="OnNumberChanged" />
                                <TextBlock Grid.Row="2" Text="阈值模式" VerticalAlignment="Center" />
                                <ComboBox x:Name="ThresholdMode" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" SelectedIndex="0" Height="32" SelectionChanged="OnModeChanged"><ComboBoxItem Content="自动" /><ComboBoxItem Content="手动" /></ComboBox>
                                <TextBlock Grid.Row="3" Text="对比度阈值" VerticalAlignment="Center" />
                                <TextBox x:Name="ContrastThreshold" Grid.Row="3" Grid.Column="1" Text="20" VerticalAlignment="Center" ToolTip="手动模式下的轮廓边缘阈值，大于 0 且不超过 255" LostKeyboardFocus="OnNumberChanged" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
            <Border Grid.Row="3" Background="#F6F7F8" BorderBrush="#DDE1E6" BorderThickness="0,1,0,0">
                <Grid Margin="12,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel x:Name="CenterPanel" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="匹配中心：( " VerticalAlignment="Center" Foreground="#737D89" />
                        <TextBox x:Name="CenterX" Text="0" Width="88" LostKeyboardFocus="OnNumberChanged" />
                        <TextBlock Text=" , " VerticalAlignment="Center" />
                        <TextBox x:Name="CenterY" Text="0" Width="88" LostKeyboardFocus="OnNumberChanged" />
                        <TextBlock Text=" )" VerticalAlignment="Center" />
                        <CheckBox x:Name="LockCenter" Content="锁定" VerticalAlignment="Center" Margin="14,0,12,0" Checked="OnLockCenter" Unchecked="OnLockCenter" />
                    </StackPanel>
                    <TextBlock x:Name="Status" Grid.Column="1" FontSize="12" Foreground="#697586" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="4,0,14,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <Button x:Name="TrainButton" Grid.Column="2" Content="训练" MinWidth="90" Height="34" VerticalAlignment="Center" Click="OnTrain" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
