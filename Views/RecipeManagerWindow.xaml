<Window x:Class="AiVisionStudio.Views.RecipeManagerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="配方管理 · ES-Vision-Studio" Width="1220" Height="760" MinWidth="980" MinHeight="580" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Microsoft YaHei UI" FontSize="13"
        Icon="/AiVisionStudio;component/Assets/Brand/ESVision.ico" Closing="OnClosing">
 <Border Background="{StaticResource Bg}" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/><RowDefinition Height="43"/></Grid.RowDefinitions>
  <Border Background="{StaticResource TechSurface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="16,10">
   <DockPanel><Image Source="/AiVisionStudio;component/Assets/Brand/EnshiLogo.png" Width="46" Margin="0,0,14,0"/>
    <StackPanel VerticalAlignment="Center"><TextBlock Text="RECIPE CENTER" Foreground="{StaticResource Accent}" FontSize="10"/><TextBlock Text="配方管理" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="ActiveText" FontSize="11" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis"/></StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Row="1" Margin="0,12,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="10">
    <DockPanel>
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="工程配方" FontSize="15" FontWeight="SemiBold" Margin="2,3,0,10"/>
      <WrapPanel x:Name="ListActions"><Button Content="＋ 新建" Click="OnNew" Margin="0,0,6,6"/><Button Content="导入…" Click="OnImport" Margin="0,0,0,6"/><Button Content="复制" Click="OnDuplicate" Margin="0,0,6,6"/><Button Content="移除关联" Click="OnRemove" Margin="0,0,0,6"/></WrapPanel>
     </StackPanel>
     <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" x:Name="EntryActions">
      <TextBox x:Name="RecipeName" ToolTip="配方显示名称"/>
      <Button Content="重命名" Click="OnRename" Margin="0,6,0,6"/>
      <Button Content="设为当前配方" Click="OnActivate" Background="{StaticResource Accent}" Foreground="White"/>
     </StackPanel>
     <ListBox x:Name="RecipeList" ItemsSource="{Binding Entries}" Background="Transparent" BorderThickness="0" SelectionChanged="OnSelection">
      <ListBox.ItemTemplate><DataTemplate><Border Margin="1,3" Padding="8" Background="{StaticResource RowBg}" CornerRadius="5"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding State}" FontSize="10" Foreground="{StaticResource Accent}" Margin="0,4,0,0"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>
   </Border>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="40"/><RowDefinition Height="*"/><RowDefinition Height="66"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="FilePathText" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
     <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="重新载入" Click="OnReload" Margin="0,0,6,0"/><Button Content="导出副本…" Click="OnExport"/></StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" Orientation="Horizontal" x:Name="RowActions"><Button Content="＋ 添加行" Click="OnAddRow" Margin="0,0,6,6"/><Button Content="复制所选行" Click="OnCopyRow" Margin="0,0,6,6"/><Button Content="删除所选行" Click="OnDeleteRow" Margin="0,0,6,6"/><TextBlock x:Name="CountText" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" Margin="10,0,0,6"/></StackPanel>
    <DataGrid x:Name="RecipeGrid" Grid.Row="2" AutoGenerateColumns="True" AutoGeneratingColumn="OnColumn"/>
    <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Margin="0,10,0,0" Padding="10">
     <StackPanel Orientation="Horizontal" x:Name="FieldActions" VerticalAlignment="Center">
      <TextBox x:Name="FieldName" Width="120" Text="parameter" ToolTip="新字段名称"/>
      <ComboBox x:Name="FieldType" Width="86" Margin="6,0" SelectedIndex="0"><ComboBoxItem Content="float"/><ComboBoxItem Content="int"/><ComboBoxItem Content="bool"/><ComboBoxItem Content="string"/></ComboBox>
      <TextBox x:Name="FieldDefault" Width="90" Text="0" ToolTip="字段默认值"/><Button Content="添加字段" Click="OnAddField" Margin="6,0,12,0"/>
      <ComboBox x:Name="RemoveField" Width="110" ToolTip="选择要移除的字段"/><Button Content="移除字段" Click="OnRemoveField" Margin="6,0,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
  </Grid>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="StatusText" Foreground="{StaticResource TextDim}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"/>
   <StackPanel Grid.Column="1" Orientation="Horizontal" x:Name="SaveActions"><Button Content="保存配方文件" Click="OnSaveRecipe" Background="{StaticResource Accent}" Foreground="White" Margin="0,0,8,0"/><Button Content="保存工程关联" Click="OnSaveProject"/></StackPanel>
  </Grid>
 </Grid></Border>
</Window>
