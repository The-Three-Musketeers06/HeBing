<Window x:Class="AiVisionStudio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:v="clr-namespace:AiVisionStudio.Views"
        Title="ES-Vision-Studio V1" Icon="/AiVisionStudio;component/Assets/Brand/ESVision.ico"
        Width="1280" Height="800" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Microsoft YaHei UI" FontSize="12" PreviewKeyDown="OnWindowKeyDown">
    <Window.Resources>
        <v:RunIconConverter x:Key="RunIcon"/>
    </Window.Resources>
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="5"
                            GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource TechSurface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" MinHeight="34" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>
        <v:TechBackdrop Grid.RowSpan="4"/>

        <!-- ============ 标题栏 ============ -->
        <Grid Grid.Row="0" Background="{StaticResource Bg}" MouseLeftButtonDown="OnTitleBarDrag">
            <Image Source="/AiVisionStudio;component/Assets/Brand/EnshiLogo.png" Width="25" Height="25" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <TextBlock x:Name="CaptionTitle" Text="ES-Vision-Studio V1" Foreground="{StaticResource Text}" FontSize="12"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,2,0">
                <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="最小化">
                    <Path Data="M4,9 L14,9" Stroke="{StaticResource TextDim}" StrokeThickness="1.2" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="OnMaximize" ToolTip="最大化">
                    <Rectangle Width="9" Height="9" Stroke="{StaticResource TextDim}" StrokeThickness="1.1" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="OnClose" ToolTip="关闭">
                    <Path Data="M5,5 L13,13 M13,5 L5,13" Stroke="{StaticResource TextDim}" StrokeThickness="1.2" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ============ 菜单栏 ============ -->
        <Menu Grid.Row="0" Background="{StaticResource Bg}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="39,0,0,0">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建工程" Click="OnNewClick" InputGestureText="Ctrl+N" IsEnabled="{Binding CanEdit}" />
                <MenuItem Header="打开工程..." Click="OnOpenClick" InputGestureText="Ctrl+O" IsEnabled="{Binding CanEdit}" />

                <MenuItem Header="最近打开" ItemsSource="{Binding RecentProjects}" IsEnabled="{Binding CanEdit}">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                            <Setter Property="Header" Value="{Binding}" />
                            <EventSetter Event="Click" Handler="OnRecentProjectClick" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="保存" Command="{Binding SaveCommand}" InputGestureText="Ctrl+S" IsEnabled="{Binding CanEdit}" />
                <MenuItem Header="另存为..." Command="{Binding SaveAsCommand}" InputGestureText="Ctrl+Shift+S" IsEnabled="{Binding CanEdit}" />
                <Separator />
                <MenuItem Header="退出" Click="OnExitClick" />
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem Header="撤销" Command="{Binding UndoCommand}" InputGestureText="Ctrl+Z" />
                <MenuItem Header="重做" Command="{Binding RedoCommand}" InputGestureText="Ctrl+Y" />
                <Separator />
                <MenuItem Header="删除算子" Click="OnCtxDelete" InputGestureText="Delete" />
                <MenuItem Header="复制算子" Click="OnCtxDuplicate" InputGestureText="Ctrl+D" />
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem x:Name="ProjectPanelMenu" Header="工程列表" IsCheckable="True" IsChecked="True" Click="OnToggleProjectPanel" />
                <MenuItem x:Name="ToolPanelMenu" Header="工具列表" IsCheckable="True" IsChecked="True" Click="OnToggleToolPanel" />
                <MenuItem x:Name="RunPanelMenu" Header="运行列表" IsCheckable="True" IsChecked="True" Click="OnToggleRunPanel" />
                <MenuItem x:Name="VariablesPanelMenu" Header="全局变量" IsCheckable="True" IsChecked="True" Click="OnToggleVariablesPanel" />
                <Separator />
                <MenuItem Header="适应图像窗口" Click="OnFitAll" />
                <MenuItem Header="还原所有图像窗口" Click="OnRestoreImagePanes" />
                <MenuItem Header="打开图像窗口..." Click="OnOpenImagePane" />
                <MenuItem Header="平铺图像窗口" Click="OnTileImages" />
                <MenuItem Header="恢复默认布局" Click="OnResetLayout" />
                <MenuItem Header="日志管理" Click="OnShowLog" />
                <MenuItem Header="全局变量管理" Click="OnManageGlobals" />
                <MenuItem Header="配方管理" Click="OnManageRecipes" />
                <MenuItem Header="HMI 运行界面" Click="OnShowHmi" InputGestureText="F8" />
                <MenuItem Header="HMI 编辑器" Click="OnEditHmi" />
                <MenuItem Header="新建 HMI 看板..." Click="OnNewHmi" />
                <MenuItem Header="打开 HMI 文件..." Click="OnOpenHmi" />
            </MenuItem>
            <MenuItem Header="设置(_S)">
                <MenuItem Header="系统参数…" Click="OnSystemSettings" IsEnabled="{Binding CanEdit}"/>
                <MenuItem Header="使用原版参照内核（数值对照）" IsCheckable="True" IsChecked="{Binding UseNativeKernel, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"
                          ToolTip="默认使用自有源码内核。勾选后使用已安装的原版内核进行对照；两种模式不会自动混用。" />
                <Separator />
                <MenuItem Header="设备配置…" Click="OnDevices" IsEnabled="{Binding CanEdit}" />
                <MenuItem Header="通信设置…" Click="OnDevices" IsEnabled="{Binding CanEdit}" />
            </MenuItem>
            <MenuItem Header="工程(_P)">
                <MenuItem Header="新建程序…" Click="OnNewProgram" IsEnabled="{Binding CanEdit}" InputGestureText="Ctrl+Shift+N" />
                <MenuItem Header="重命名程序…" Click="OnRenameProgram" IsEnabled="{Binding CanEdit}" />
                <MenuItem Header="设为默认程序" Click="OnDefaultProgram" IsEnabled="{Binding CanEdit}" />
                <MenuItem Header="删除程序" Click="OnDeleteProgram" IsEnabled="{Binding CanEdit}" />
                <Separator/>
                <MenuItem Header="全局变量管理…" Click="OnManageGlobals" />
                <MenuItem Header="配方管理…" Click="OnManageRecipes" />
                <Separator/>
                <MenuItem Header="运行" Command="{Binding RunCommand}" InputGestureText="F5" />
                <MenuItem Header="单步" Command="{Binding StepCommand}" InputGestureText="F10" />
            </MenuItem>
            <MenuItem Header="调试(_D)">
                <MenuItem Header="断点" Click="OnCtxToggleBreakpoint" />
                <MenuItem Header="单步进入" Command="{Binding StepCommand}" InputGestureText="F10" />
                <MenuItem Header="暂停（当前工具完成后）" Click="OnPause" InputGestureText="Ctrl+F4"/>
                <MenuItem Header="清空运行结果" Click="OnClearResults" InputGestureText="Ctrl+F6" IsEnabled="{Binding CanEdit}"/>
            </MenuItem>
            <MenuItem Header="语言(_L)">
                <MenuItem Header="中文" IsCheckable="True" IsChecked="True" Click="OnChineseLanguage" />
                <MenuItem Header="English" IsEnabled="False" ToolTip="英文界面尚未实现" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="使用手册（当前工具）" Click="OnManual" InputGestureText="F1"/>
                <MenuItem Header="手册功能核对清单…" Click="OnManualAudit"/>
                <MenuItem Header="关于" Click="OnAboutClick" />
            </MenuItem>
        </Menu>

        <!-- ============ 工具栏 ============ -->
        <Border Grid.Row="1" Margin="7,0" CornerRadius="5" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,1">
            <Grid Margin="6,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <WrapPanel x:Name="MainToolStrip" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolButton}" ToolTip="新建" Click="OnNewClick" IsEnabled="{Binding CanEdit}">
                        <Path Data="M3,2 L11,2 L13,4 L13,14 L3,14 Z" Stroke="{StaticResource Text}" StrokeThickness="1.1" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="打开" Click="OnOpenClick" IsEnabled="{Binding CanEdit}">
                        <Path Data="M2,4 L7,4 L8,6 L14,6 L14,13 L2,13 Z" Stroke="{StaticResource Text}" StrokeThickness="1.1" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="保存" Command="{Binding SaveCommand}" IsEnabled="{Binding CanEdit}">
                        <Path Data="M2,2 L12,2 L14,4 L14,14 L2,14 Z M5,2 L5,7 L11,7 L11,2" Stroke="{StaticResource Text}" StrokeThickness="1.1" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="另存为" Command="{Binding SaveAsCommand}" IsEnabled="{Binding CanEdit}">
                        <Path Data="M2,2 L12,2 L14,4 L14,11 M2,2 L2,14 L8,14 M5,2 L5,7 L11,7 L11,2 M9,15 L15,9 L17,11 L11,17 L8,18 Z" Stroke="{StaticResource Accent}" StrokeThickness="1.1" />
                    </Button>
                    <Rectangle Width="1" Fill="{StaticResource Border}" Margin="5,6" />
                    <Button Style="{StaticResource ToolButton}" ToolTip="撤销" Command="{Binding UndoCommand}">
                        <Path Data="M6,5 L2,8 L6,11 M2,8 L12,8" Stroke="{StaticResource Text}" StrokeThickness="1.2" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="重做" Command="{Binding RedoCommand}">
                        <Path Data="M10,5 L14,8 L10,11 M14,8 L4,8" Stroke="{StaticResource Text}" StrokeThickness="1.2" />
                    </Button>
                    <Rectangle Width="1" Fill="{StaticResource Border}" Margin="5,6" />
                    <Button Style="{StaticResource ToolButton}" ToolTip="运行" Command="{Binding RunCommand}">
                        <Path Data="M3,2 L13,8 L3,14 Z" Fill="{StaticResource Ok}" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="停止" Command="{Binding StopCommand}">
                        <Rectangle Width="10" Height="10" Fill="{StaticResource Fail}" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="单步" Command="{Binding StepCommand}">
                        <Path Data="M3,2 L10,8 L3,14 Z M11,2 L13,2 L13,14 L11,14 Z" Fill="{StaticResource Text}" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="连续运行" Click="OnCycleRun" IsEnabled="{Binding CanEdit}">
                        <Path Data="M3,2 L9,8 L3,14 Z M8,2 L14,8 L8,14 Z" Fill="{StaticResource Ok}" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="删除所选算子" Click="OnCtxDelete" IsEnabled="{Binding CanEdit}">
                        <Path Data="M3,4 L13,4 M6,2 L10,2 M4,4 L5,14 L11,14 L12,4 M7,6 L7,12 M9,6 L9,12" Stroke="{StaticResource Fail}" StrokeThickness="1.1" />
                    </Button>
                    <Rectangle Width="1" Fill="{StaticResource Border}" Margin="5,6" />
                    <Button Style="{StaticResource ToolButton}" ToolTip="日志" Click="OnShowLog">
                        <Path Data="M3,2 L13,2 L13,14 L3,14 Z M5,5 L11,5 M5,8 L11,8 M5,11 L9,11" Stroke="{StaticResource Text}" StrokeThickness="1.1" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="参数" Click="OnShowParams">
                        <Path Data="M3,4 L13,4 M3,8 L13,8 M3,12 L13,12 M6,2 L6,6 M10,6 L10,10 M7,10 L7,14" Stroke="{StaticResource Text}" StrokeThickness="1.1" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="HMI 运行界面 (F8)" Click="OnShowHmi">
                        <Path Data="M1,2 L15,2 L15,12 L1,12 Z M5,15 L11,15 M8,12 L8,15 M4,5 L7,5 L7,9 L4,9 Z M10,5 L12,5 M10,8 L12,8" Stroke="{StaticResource Accent}" StrokeThickness="1.1" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="恢复默认布局" Click="OnResetLayout">
                        <Path Data="M8,2 L9.5,5 L13,5.5 L10.5,8 L11,11.5 L8,10 L5,11.5 L5.5,8 L3,5.5 L6.5,5 Z" Stroke="{StaticResource Text}" StrokeThickness="1.1" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="打开图像窗口" Click="OnOpenImagePane">
                        <Path Data="M1,2 L15,2 L15,14 L1,14 Z M5,6 L11,6 M8,3 L8,9" Stroke="{StaticResource Accent}" StrokeThickness="1.1" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="平铺图像窗口" Click="OnTileImages">
                        <Path Data="M1,2 L7,2 L7,7 L1,7 Z M9,2 L15,2 L15,7 L9,7 Z M1,9 L7,9 L7,14 L1,14 Z M9,9 L15,9 L15,14 L9,14 Z" Stroke="{StaticResource Accent}" StrokeThickness="1.1" />
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="全局变量管理" Click="OnManageGlobals">
                        <TextBlock Text="var" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource Accent}" FontSize="12"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="配方管理" Click="OnManageRecipes">
                        <Path Data="M2,2 L14,2 L14,14 L2,14 Z M5,5 L11,5 M5,8 L11,8 M5,11 L9,11" Stroke="{StaticResource Accent}" StrokeThickness="1.2"/>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" ToolTip="设备配置" Click="OnDevices" IsEnabled="{Binding CanEdit}"><TextBlock Text="⚙" Foreground="{StaticResource Accent}" FontSize="18"/></Button>
                </WrapPanel>
                <TextBlock x:Name="ToolbarStatus" Grid.Column="1" MaxWidth="230" Text="{Binding Status}" Foreground="{StaticResource TextDim}" FontSize="11" TextAlignment="Right" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="8,0" />
            </Grid>
        </Border>

        <!-- ============ 主体 ============ -->
        <Grid x:Name="WorkspaceGrid" Grid.Row="2" Margin="7,4,7,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LeftColumn" Width="16*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition x:Name="RunColumn" Width="23*" />
                <ColumnDefinition x:Name="RunSplitterColumn" Width="5" />
                <ColumnDefinition x:Name="ImageColumn" Width="61*" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- 左：工程列表 + 工具列表 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ProjectRow" Height="30*" MinHeight="70" />
                    <RowDefinition x:Name="LeftSplitterRow" Height="5" />
                    <RowDefinition x:Name="ToolRow" Height="70*" MinHeight="100" />
                </Grid.RowDefinitions>

                <Border x:Name="ProjectPanel" Grid.Row="0" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Background="{StaticResource ProjectZone}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path Data="M2,4 L6,4 L7,6 L13,6 L13,12 L2,12 Z" Stroke="{StaticResource Text}" StrokeThickness="1" />
                                    <TextBlock Text="工程列表" Style="{StaticResource PanelTitle}" Margin="6,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource CaptionButton}" ToolTip="隐藏工程列表" Click="OnHideProjectPanel">
                                        <Path Data="M4,9 L12,9" Stroke="{StaticResource TextDim}" StrokeThickness="1.2" />
                                    </Button>
                                    <Button Style="{StaticResource CaptionButton}" ToolTip="新建程序" Click="OnNewProgram" IsEnabled="{Binding CanEdit}">
                                        <Path Data="M3,8 L13,8 M8,3 L8,13" Stroke="{StaticResource Accent}" StrokeThickness="1.5" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DockPanel Margin="8,6,8,0">
                            <DockPanel DockPanel.Dock="Top">
                                <Path Data="M2,3 L6,3 L7,5 L12,5 L12,11 L2,11 Z" Stroke="{StaticResource TextDim}" StrokeThickness="1" Margin="0,0,5,0" />
                                <TextBlock Text="默认" FontSize="11" Foreground="{StaticResource TextDim}"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ProjectName}" FontSize="11" Foreground="{StaticResource Text}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                            <TreeView x:Name="ProgramTree" ItemsSource="{Binding Programs}" Background="Transparent" BorderThickness="0" IsEnabled="{Binding CanEdit}"
                                      Margin="0,4,0,0" SelectedItemChanged="OnProgramSelected">
                                <TreeView.ContextMenu><ContextMenu><MenuItem Header="新建程序…" Click="OnNewProgram"/><MenuItem Header="重命名…" Click="OnRenameProgram"/><MenuItem Header="设为默认" Click="OnDefaultProgram"/><MenuItem Header="删除程序" Click="OnDeleteProgram"/></ContextMenu></TreeView.ContextMenu>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                        <Setter Property="IsExpanded" Value="True" />
                                        <Setter Property="IsSelected" Value="False"/>
                                        <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnProgramRightClick"/>
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" FontSize="12" Margin="4,5" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="默认" FontSize="10" Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="8,0,2,0" Visibility="{Binding IsDefault, Converter={StaticResource ToolBooleanVisibility}}"/></Grid>
                                    </DataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>
                    </DockPanel>
                </Border>

                <v:ClampedGridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" Cursor="SizeNS" />

                <Border x:Name="ToolPanel" Grid.Row="2" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Background="{StaticResource ToolZone}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Path Data="M3,3 L13,3 M3,8 L13,8 M3,13 L13,13" Stroke="{StaticResource Text}" StrokeThickness="1.1" />
                                    <TextBlock Text="工具列表" Style="{StaticResource PanelTitle}" Margin="6,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource CaptionButton}" ToolTip="隐藏工具列表" Click="OnHideToolPanel">
                                        <Path Data="M4,9 L12,9" Stroke="{StaticResource TextDim}" StrokeThickness="1.2" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <DockPanel>
                            <Border DockPanel.Dock="Top" Margin="8,5,8,4" Background="Transparent" Height="32"
                                    PreviewMouseLeftButtonDown="OnSearchAreaMouseDown">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="20" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" BorderThickness="0"
                                             Background="Transparent" Padding="4,3" FontSize="15"
                                             TextChanged="OnSearchTextChanged"
                                             TextCompositionManager.PreviewTextInputStart="OnSearchCompositionStarted"
                                             TextCompositionManager.PreviewTextInputUpdate="OnSearchCompositionStarted"
                                             PreviewTextInput="OnSearchCompositionCompleted"
                                             PreviewKeyUp="OnSearchKeyUp" LostKeyboardFocus="OnSearchFocusLost" />
                                    <TextBlock x:Name="SearchPlaceholder" Text="查找" Foreground="{StaticResource TextDim}" Margin="4,0,0,0" FontSize="15" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Text, ElementName=SearchBox}" Value="" />
                                                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBox}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Path Grid.Column="1" Data="M2,3 a5,5 0 1,1 0,9 a5,5 0 1,1 0,-9 M9,10 L13,14"
                                          Stroke="{StaticResource TextDim}" StrokeThickness="1.1" Width="14" Height="14"
                                          Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                </Grid>
                            </Border>


                            <!-- 工具目录字体层级：一级17、二级15、三级及以下13；不依赖转换器 -->
                            <TreeView x:Name="ToolTree"
                                      Style="{StaticResource ToolTree}"
                                      Margin="0,0,0,4"
                                      IsEnabled="{Binding CanEdit}"
                                      ItemsSource="{Binding Tools}"
                                      MouseDoubleClick="OnToolDoubleClick"
                                      PreviewMouseLeftButtonDown="OnToolPreviewMouseDown"
                                      PreviewMouseMove="OnToolMouseMove">
                                <TreeView.ItemTemplate>
    <HierarchicalDataTemplate ItemsSource="{Binding Children}" ItemContainerStyle="{StaticResource ToolTreeItem}">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="Kind" Text="&#x25A1;" Foreground="{StaticResource Accent}" Width="19" VerticalAlignment="Center"/>
            <TextBlock x:Name="Name" Grid.Column="1" Text="{Binding Display}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Display}" FontSize="13"/>
            <Border x:Name="Count" Grid.Column="2" Background="{StaticResource PanelHead}" CornerRadius="5" Padding="4,1" Margin="4,0,2,0"><TextBlock Text="{Binding ToolCount}" FontSize="10" Foreground="{StaticResource TextDim}"/></Border>
        </Grid>
        <HierarchicalDataTemplate.Triggers>
            <DataTrigger Binding="{Binding Depth}" Value="0"><Setter TargetName="Name" Property="FontWeight" Value="SemiBold"/><Setter TargetName="Name" Property="FontSize" Value="15"/></DataTrigger>
            <DataTrigger Binding="{Binding IsLeaf}" Value="True"><Setter TargetName="Kind" Property="Text" Value="&#x25C7;"/><Setter TargetName="Count" Property="Visibility" Value="Collapsed"/><Setter TargetName="Name" Property="FontSize" Value="12"/></DataTrigger>
        </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>
</TreeView.ItemTemplate>
                            </TreeView>

                        </DockPanel>
                    </DockPanel>
                </Border>
            </Grid>

            <v:ClampedGridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" Cursor="SizeWE" />

            <!-- 中：运行列表 -->
            <Border x:Name="RunPanel" Grid.Column="2" Style="{StaticResource PanelBorder}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Background="{StaticResource RunZone}">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Data="M2,3 L12,3 M2,8 L12,8 M2,13 L12,13" Stroke="{StaticResource Text}" StrokeThickness="1.1" />
                                <TextBlock Text="运行列表" Style="{StaticResource PanelTitle}" Margin="6,0,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Style="{StaticResource CaptionButton}" ToolTip="隐藏运行列表" Click="OnHideRunPanel">
                                    <Path Data="M4,9 L12,9" Stroke="{StaticResource TextDim}" StrokeThickness="1.2" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid>
                        <TextBlock Text="运行" FontSize="105" Foreground="#DDEBF3" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,30,0,0" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Operations.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ListBox x:Name="RunList" Style="{StaticResource RunListBox}" Margin="7,4,5,4"
                             ItemsSource="{Binding Operations}"
                             SelectedItem="{Binding SelectedOperation, Mode=TwoWay}"
                             SelectionChanged="OnRunSelectionChanged"
                             PreviewMouseLeftButtonDown="OnRunPreviewMouseDown"
                             PreviewMouseLeftButtonUp="OnRunPreviewMouseUp"
                             PreviewMouseMove="OnRunMouseMove"
                             PreviewMouseRightButtonDown="OnRunPreviewMouseRightDown"
                             AllowDrop="True" DragOver="OnRunDragOver" Drop="OnRunDrop"
                             MouseDoubleClick="OnRunDoubleClick">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="重命名..." InputGestureText="F2" Click="OnCtxRename" />
                                    <MenuItem Header="删除" Click="OnCtxDelete" />
                                    <MenuItem Header="复制" Click="OnCtxDuplicate" />
                                    <MenuItem Header="启用/禁用" Click="OnCtxToggleEnabled" />
                                    <MenuItem Header="断点" Click="OnCtxToggleBreakpoint" />
                                    <Separator />
                                    <MenuItem Header="参数..." Click="OnShowParams" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="39" Margin="0,0,4,0" ToolTip="{Binding ErrorMessage}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="48" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Index}" Foreground="{StaticResource TextDim}" FontSize="11"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Path Grid.Column="1" Data="{Binding Driver, Converter={StaticResource RunIcon}}"
                                          Stroke="{StaticResource Accent}" StrokeThickness="1" Width="17" Height="17"
                                          Stretch="Uniform" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{StaticResource Text}"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,0,0" />
                                        <TextBlock Grid.Column="4" Text="{Binding ElapsedMs, StringFormat={}{0:0.00}}"
                                               Foreground="{StaticResource TextDim}" FontSize="11"
                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <Grid Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Ellipse x:Name="stateCircle" Width="14" Height="14" Stroke="{StaticResource TextFaint}" StrokeThickness="1" />
                                            <Path x:Name="tick" Data="M3,7 L6,10 L11,4" Stroke="White" StrokeThickness="1.5"
                                              Width="10" Height="10" Stretch="Uniform" Visibility="Collapsed" />
                                            <Path x:Name="cross" Data="M3,3 L11,11 M11,3 L3,11" Stroke="{StaticResource Fail}" StrokeThickness="1.4"
                                              Width="10" Height="10" Stretch="Uniform" Visibility="Collapsed" />
                                        </Grid>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsOk}" Value="True">
                                            <Setter TargetName="tick" Property="Visibility" Value="Visible" />
                                            <Setter TargetName="stateCircle" Property="Fill" Value="{StaticResource Ok}" />
                                            <Setter TargetName="stateCircle" Property="Stroke" Value="{StaticResource Ok}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsFail}" Value="True">
                                            <Setter TargetName="cross" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <v:ClampedGridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" Cursor="SizeWE" />

            <!-- 右：图像视图 + 全局变量 -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition x:Name="VariablesSplitterRow" Height="5" />
                    <RowDefinition x:Name="VariablesRow" Height="220" MinHeight="80" />
                </Grid.RowDefinitions>
                <v:ImageWorkspace x:Name="ImageWorkspace" Grid.Row="0" />

                <v:ClampedGridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" Cursor="SizeNS" />

                <Border x:Name="VariablesPanel" Grid.Row="2" Style="{StaticResource PanelBorder}">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Style="{StaticResource PanelHeader}" Background="{StaticResource VariablesZone}">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource CaptionButton}" ToolTip="查看全局变量" Click="OnGlobalVariables">
                                        <Path Data="M1,2 L15,2 L15,14 L1,14 Z M4,6 L6,10 L8,6 M10,6 L13,6 M10,9 L13,9" Stroke="{StaticResource Accent}" StrokeThickness="1"/>
                                    </Button>
                                    <TextBlock x:Name="VariablesTitle" Text="全局变量" Style="{StaticResource PanelTitle}" Margin="2,0,8,0" />
                                    <Button Style="{StaticResource CaptionButton}" ToolTip="查看选中算子输出" Click="OnOperationOutputs">
                                        <Path Data="M1,2 L15,2 L15,6 L1,6 Z M1,9 L7,9 L7,14 L1,14 Z M10,9 L15,9 M10,12 L15,12" Stroke="{StaticResource Accent}" StrokeThickness="1"/>
                                    </Button>
                                    <Button Style="{StaticResource CaptionButton}" ToolTip="全局变量管理" Click="OnManageGlobals">
                                        <TextBlock Text="⚙" Foreground="{StaticResource Accent}" FontSize="17"/>
                                    </Button>
                                    <Button Style="{StaticResource CaptionButton}" ToolTip="配方管理" Click="OnManageRecipes">
                                        <TextBlock Text="▦" Foreground="{StaticResource Accent}" FontSize="17"/>
                                    </Button>
                                    <Button Style="{StaticResource CaptionButton}" ToolTip="查看运行日志" Click="OnShowLog">
                                        <Path Data="M2,2 L13,2 L13,14 L2,14 Z M4,5 L10,5 M4,8 L10,8 M4,11 L8,11" Stroke="{StaticResource Accent}" StrokeThickness="1"/>
                                    </Button>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource CaptionButton}" ToolTip="隐藏全局变量" Click="OnHideVariablesPanel">
                                        <Path Data="M4,9 L12,9" Stroke="{StaticResource TextDim}" StrokeThickness="1.2" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid DockPanel.Dock="Top" Height="32" Margin="0,0,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="名称" Margin="18,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="类型" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="值" VerticalAlignment="Center" />
                        </Grid>
                        <TreeView x:Name="VariablesTree" ItemsSource="{Binding GlobalVars}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" TreeViewItem.Expanded="OnVariableExpanded"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="True">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem">
                                    <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <Grid Height="24">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="220" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" Margin="18,0,0,0" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="5,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Type}" FontSize="11" Foreground="{StaticResource Accent}" />
                                        </Border>
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{StaticResource Text}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ============ 状态栏 ============ -->
        <Border Grid.Row="3" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusPath}" Foreground="{StaticResource TextDim}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding RunTimeText}" Foreground="{StaticResource TextDim}" FontSize="11"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock Grid.Column="2" Text="{Binding BackendText}" Foreground="{StaticResource TextDim}" FontSize="11"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock Grid.Column="3" Text="{Binding CpuText}" Foreground="{StaticResource TextDim}" FontSize="11"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock Grid.Column="4" Text="{Binding MemText}" Foreground="{StaticResource TextDim}" FontSize="11"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock Grid.Column="5" Text="{Binding AuthText}" Foreground="{StaticResource TextDim}" FontSize="11"
                           VerticalAlignment="Center" Margin="12,0,8,0" />
            </Grid>
        </Border>
    </Grid>
</Window>
